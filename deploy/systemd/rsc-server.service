[Unit]
Description=RemoteSessionControl Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/RemoteSessionControl
ExecStart=/opt/RemoteSessionControl/.venv/bin/uvicorn apps.server.app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
